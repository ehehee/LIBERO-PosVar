(define (problem LIBERO_Kitchen_Popcorn_Production)
  (:domain robosuite)
  (:language put the frying pan on the stove turn on the stove then turn it off and move the frying pan off the stove)
    (:regions
      (flat_stove_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2000000000000002 0.30 -0.2 0.300000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (frypan_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.075 -0.35 0.07500000000000001 -0.15)
            )
          )
          (:yaw_rotation (
              (0.0 3.14)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    chefmate_8_frypan_1 - chefmate_8_frypan
  )

  (:obj_of_interest
    flat_stove_1
    chefmate_8_frypan_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_init_region)
    (On chefmate_8_frypan_1 kitchen_table_frypan_init_region)
  )

  (:goal
    (Sequence
      (On chefmate_8_frypan_1 flat_stove_1_cook_region)
      (Turnon flat_stove_1)
      (Turnoff flat_stove_1)
      (Not (On chefmate_8_frypan_1 flat_stove_1_cook_region))
    )
  )

)
